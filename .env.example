# ------------------------------------------------------------------
# Environment template.
# Copy this file to `.env.<NODE_ENV>` and fill in the values:
#   cp .env.example .env.development   # used by: npm run start / start:dev / typeorm
#   cp .env.example .env.test          # used by: npm run test / test:e2e (set DB_NAME=test.sqlite)
# Real .env.* files are git-ignored. Never commit secrets.
# ------------------------------------------------------------------

# HTTP port the server listens on (defaults to 4000 if unset)
PORT=4000

# SQLite database file (created automatically on first run)
DB_NAME=db.sqlite

# Secret used to sign the session cookie. REQUIRED — the app will not start without it.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_KEY=replace-with-a-long-random-string

# --- Production only (src/config/database.config.ts, Postgres) -------------
# Not used by the running app yet; requires the `pg` package to be installed.
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=
